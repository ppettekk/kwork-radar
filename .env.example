# --- Kwork ---
KWORK_LOGIN=your_login
KWORK_PASSWORD=your_password
# Последние 4 цифры телефона - Kwork иногда требует их при входе с нового IP
KWORK_PHONE_LAST=
# Прокси на случай "Подтвердите, что вы не робот": socks5://user:pass@host:port
KWORK_PROXY=

# --- Telegram ---
TG_BOT_TOKEN=123456:AA...
TG_CHAT_ID=123456789

# --- CloseRouter ---
CLOSEROUTER_API_KEY=closerouter_...
CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1
LLM_MODEL=openai/gpt-5.4-mini
LLM_ENABLED=true
# Доп. проход, если модель всё-таки поставила тире (одна лишняя дешёвая генерация)
REPAIR_DASHES=true

# --- Фильтры ---
# ID рубрик через запятую, all - все, пусто - избранные рубрики аккаунта.
# Список ID: python main.py categories
CATEGORIES=
MAX_OFFERS=5
MIN_PRICE=1500
MAX_PRICE=
HIRING_FROM=
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=казино,ставки,беттинг,крипто-обменник

# --- Поведение ---
POLL_INTERVAL=45
NOTIFY_ON_FIRST_RUN=false
DB_PATH=radar.db
PROFILE_PATH=profile.md
